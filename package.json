{
  "name": "aqualink",
  "version": "4.0.0",
  "description": "Extensible, Performant, lightweight Lavalink v4 and NodeLink client.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs-types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "bun ./build.ts",
    "prepack": "bun run build",
    "typecheck": "bun check"
  },
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToddyTheNoobDud/AquaLink.git"
  },
  "homepage": "https://github.com/ToddyTheNoobDud/AquaLink#readme",
  "bugs": {
    "url": "https://github.com/ToddyTheNoobDud/AquaLink/issues"
  },
  "keywords": [
    "lavalink",
    "nodelink",
    "discord",
    "music",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^7"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  }
}
